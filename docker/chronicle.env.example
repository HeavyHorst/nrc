# Copy to /root/nrc/chronicle.env only for an approved activation.
# Its presence opts subsequent deploys/backups into the Chronicle overlay.
# Keep capture/service/delete policies in the server's private .env, not here.
# Both files must be regular files, owned by 65532:65532, mode 0600.
# Directory must be absolute, outside Git, traversable by UID 65532.
NRC_CHRONICLE_CREDENTIAL_DIR=/etc/nrc/chronicle
