# Copy to .env and set secrets before starting. Never commit .env.
# Generate each secret independently, for example with: openssl rand -hex 32
# The proxy and server use the SAME NRC_JWT_SECRET; bots use NRC_BOT_SECRET.
NRC_JWT_SECRET=
NRC_BOT_SECRET=

# Tailscale node enrollment key. Enable MagicDNS and HTTPS in your tailnet.
TS_AUTHKEY=

# Optional workspace restrictions. Unlisted workspaces remain tailnet-open.
# Removing an entry opens that workspace again. Recreate services after changes.
# NRC_WORKSPACE_ACCESS='{"private":{"owner":"alice@example.com","members":["bob@example.com"]}}'
# On existing installations, read the file-grant migration instructions first:
# services/auth/tailscale-proxy/README.md
NRC_WORKSPACE_ACCESS=

# Customer UI visibility only; NOT a data-access restriction.
# Comma-separated full verified Tailscale logins, no wildcards.
NRC_CUSTOMERS_USERS=

# Optional room-message retention: 0, or a positive integer with s/m/h/d.
# DMs remain ephemeral. Default retention is disabled.
NRC_MESSAGE_RETENTION=0
# Retry deduplication defaults to 2m when retention is enabled; cannot exceed it.
NRC_MESSAGE_DEDUP_WINDOW=2m
# Per-shard retained-message WAL quota in bytes; 0 means no quota.
NRC_MESSAGE_STORE_QUOTA_BYTES=0
# Per-worker cache budgets (serialized payload/index bytes, not total RSS).
NRC_MESSAGE_ACTIVE_CACHE_BYTES=268435456
NRC_MESSAGE_SEALED_INDEX_CACHE_BYTES=134217728
# Unique retained-message records per worker commit turn; 0 disables the count cap.
NRC_MESSAGE_WRITE_BATCH_RECORDS=16

# Only needed for the ai Compose profile; hosted providers require an API key.
# Search runs locally; AI sends supplied/retrieved context to this provider.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
# LLM_BASE_URL=

# Optional metrics profile: bind to loopback unless remote access is intentional.
NRC_METRICS_BIND_ADDRESS=127.0.0.1
