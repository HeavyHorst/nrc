# Copy to .env and set secrets before starting. Never commit .env.
# Generate each secret independently, for example with: openssl rand -hex 32
# The proxy, server and AI use the SAME NRC_JWT_SECRET (at least 32 bytes).
# Bots, including AI, also use NRC_BOT_SECRET for their server connections.
NRC_JWT_SECRET=
NRC_BOT_SECRET=

# Existing installations: set the verified data volume after an offline migration.
# Empty uses <compose-project>_task-data. deploy.sh refuses a different live mount.
# NRC_TASK_DATA_VOLUME=your-verified-sqlite-volume

# Tailscale node enrollment key. Enable MagicDNS and HTTPS in your tailnet.
TS_AUTHKEY=

# Optional workspace restrictions. Unlisted workspaces remain tailnet-open.
# Removing an entry opens that workspace again. Recreate services after changes.
# NRC_WORKSPACE_ACCESS='{"private":{"owner":"alice@example.com","members":["bob@example.com"]}}'
# On existing installations, read the file-grant migration instructions first:
# services/auth/tailscale-proxy/README.md
NRC_WORKSPACE_ACCESS=

# Optional Sullivan knowledge-gap task destinations, keyed by exact workspace name.
# Create each slice first; use its stable ID as a string, not its display name.
# NRC_KNOWLEDGE_GAP_SLICES='{"workspace1":"51","support":"82"}'
NRC_KNOWLEDGE_GAP_SLICES=

# Experimental note-history capture and service API. Exact comma-separated IDs;
# keep empty outside disposable tests until fake-provider worker acceptance.
# Changes apply on server restart. This does not enable any provider calls.
NRC_CHRONICLE_WORKSPACES=

# Exact workspace -> arrays of verified JWT subjects. Empty defaults deny.
# Dedicated service JWTs require capability:"chronicle", user_type:"bot", and
# a nonempty workspace claim matching the upgrade path. Legacy headers grant no rights.
# NRC_CHRONICLE_SERVICE_SUBJECTS='{"workspace1":["chronicle-worker"]}'
NRC_CHRONICLE_SERVICE_SUBJECTS=
# Human deletion requires a verified human JWT and an exact subject allowlist match.
# NRC_CHRONICLE_DELETE_SUBJECTS='{"workspace1":["alice@example.com"]}'
NRC_CHRONICLE_DELETE_SUBJECTS=
# Invalid JSON/shape refuses startup. Both maps are fixed until server restart.

# Customer UI visibility only; NOT a data-access restriction.
# Comma-separated full verified Tailscale logins, no wildcards.
NRC_CUSTOMERS_USERS=

# Optional room and DM message retention: 0, or a positive integer with s/m/h/d.
# Default retention is disabled.
NRC_MESSAGE_RETENTION=0
# Retry deduplication defaults to 2m when retention is enabled; cannot exceed it.
NRC_MESSAGE_DEDUP_WINDOW=2m
# Per-shard retained-message WAL quota in bytes; 0 means no quota.
NRC_MESSAGE_STORE_QUOTA_BYTES=0
# Per-worker cache budgets (serialized payload/index bytes, not total RSS).
NRC_MESSAGE_ACTIVE_CACHE_BYTES=268435456
NRC_MESSAGE_SEALED_INDEX_CACHE_BYTES=134217728
# Unique retained-message records per worker commit turn; 0 disables the count cap.
NRC_MESSAGE_WRITE_BATCH_RECORDS=16

# Optional remote text/image/audio embeddings; empty URL keeps local ONNX only.
# Full endpoint, e.g. http://gpu-server:18080/v1/embeddings (trusted network only).
# Match the local ONNX weights; see services/bots/nrc-search/README.md.
SEARCH_VLLM_URL=
SEARCH_VLLM_MODEL=google/embeddinggemma-2
SEARCH_VLLM_TIMEOUT=3s
# Experimental: media parity differs for some inputs; keep local by default.
SEARCH_VLLM_MEDIA=false

# Only needed for the ai Compose profile; hosted providers require an API key.
# AI sends supplied/retrieved context to this provider.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
# LLM_BASE_URL=
# OpenAI only: set fast for Fast mode; empty preserves the provider default.
# LLM_SERVICE_TIER=fast

# Separate nrc-ai process only; replaces its HTTP/chat runtime. Default off.
# fake results/gaps are terminal, not a dry run; use disposable workspaces.
# NRC_CHRONICLE_MODE=fake
# Private JSON workspace -> dedicated service JWT file, loaded at startup.
# No signing secret or broad NRC_BOT_SECRET needed in either mode.
# NRC_CHRONICLE_TOKEN_FILE=/private/chronicle-tokens.json
# Real-provider alternative: NRC_CHRONICLE_MODE=terra, only after explicit approval.
# Fixed gpt-6-luna Responses profile; legacy mode name terra stays unchanged.
# No LLM_API_KEY/LLM_BASE_URL fallback.
# Private regular API key file (0600), loaded at startup; not needed for fake.
# NRC_CHRONICLE_API_KEY_FILE=/private/chronicle-api-key
# No production activation here. store=false is not a zero-retention guarantee.

# Optional automatic ticket categories; comma-separated workspace names.
# Sends new tickets' titles and original bodies to OpenAI Decisions (gpt-6-luna).
# Empty disables it. No historical backfill; failures leave the category unset.
# NRC_TICKET_CLASSIFICATION_WORKSPACES=your-workspace
# Uses LLM_API_KEY only for openai without LLM_BASE_URL. Otherwise supply:
# NRC_TICKET_OPENAI_API_KEY=

# Optional personal Sullivan memory. Empty keeps storage and its worker disabled.
# New accounts remember by default; saved opt-outs remain disabled.
# Compose provides a private non-root-owned volume at /data/personal.
# NRC_PERSONAL_MEMORY_PATH=/data/personal/memory.db
# Optional summary model; defaults to gpt-6.1-sol for OpenAI, otherwise LLM_MODEL.
# NRC_MEMORY_SUMMARY_MODEL=
# Summaries share LLM_MAX_OUTPUT_TOKENS with chat, including reasoning.
# Stored summaries remain at most 512 UTF-8 bytes.

# Optional Sullivan voice prototype; empty disables billed GPT-Live sessions.
# Requires OpenAI project access to gpt-live-1. Independent of LLM_PROVIDER.
# NRC_VOICE_OPENAI_API_KEY=
# Optional custom voice; unset or empty leaves the provider voice default.
# Opt-in example for this installation; requires access to this saved voice:
# NRC_VOICE_OPENAI_VOICE_ID=voice_6aec886c508081918e0df89198e00d76

# Optional metrics profile: bind to loopback unless remote access is intentional.
NRC_METRICS_BIND_ADDRESS=127.0.0.1

# Optional footer health probes: enable only for services you actually deploy.
# Empty means NOT CONFIGURED, not an outage. These URLs are private proxy targets.
# NRC_SEARCH_HEALTH_URL=http://search:8090/health
# NRC_AI_HEALTH_URL=http://ai:8091/health
# NRC_METRICS_HEALTH_URL=http://metrics-bot:8092/health
# The publishing Compose overlay supplies NRC_PUBLISH_HEALTH_URL automatically.
# Newsletter and tickets overlays likewise supply NRC_NEWSLETTER_HEALTH_URL
# (http://newsletter:8097/health) and NRC_TICKETS_HEALTH_URL (http://tickets:8096/health).
NRC_SEARCH_HEALTH_URL=
NRC_AI_HEALTH_URL=
NRC_METRICS_HEALTH_URL=

# Optional newsletter overlay. These are separate sending permissions, not just UI visibility.
NRC_NEWSLETTER_WORKSPACE=
NRC_NEWSLETTER_USERS=
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
# Explicit comma-separated approved transactional template IDs.
NEWSLETTER_TEMPLATE_IDS=
NEWSLETTER_FROM_EMAIL=
NEWSLETTER_FROM_NAME=
NEWSLETTER_REPLY_TO=
# Dedicated public HTTPS origin for confirmation, unsubscribe and authenticated events ONLY.
NEWSLETTER_PUBLIC_URL=
# Generate independently; configure Mailjet callbacks with this Basic auth password.
NEWSLETTER_EVENT_SECRET=

# Optional docker/compose.calls.yml: separately hosted, JWT-authenticated Jitsi.
# JITSI_SECRET is Jitsi's app secret, not NRC_JWT_SECRET (both >=32 bytes).
JITSI_URL=
JITSI_APP_ID=
JITSI_SECRET=
